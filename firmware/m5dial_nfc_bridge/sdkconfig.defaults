# Target: M5Dial original (Stamp-S3) and v1.1 (Stamp-S3A).
# Both modules are ESP32-S3FN8: 8 MB quad flash, 3.3 V. Official product
# pages do not list PSRAM, so this firmware must not enable it.
# https://docs.m5stack.com/en/core/Dial
# https://docs.m5stack.com/en/core/Dial_v1.1
#
# SPI mode is DIO at 80 MHz, matching the GigaDevice flash identified on
# hardware (JEDEC c8/4017). QIO makes the chip watchdog-reset in a loop
# (rst:0x7 TG0WDT_SYS_RST). The image header must say 8 MB; a larger size
# fails the bootloader probe because the chip is smaller than the header.
CONFIG_IDF_TARGET_ESP32S3=y

# TinyUSB: expose the M5Dial as a USB CDC (serial) device so the web app's
# Web Serial path can talk pcg.reader.v1.
CONFIG_TINYUSB_CDC_ENABLED=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=n

# Pin the same single-app map the bridge already uses, and keep it inside 8 MB.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# NFC reader I2C pins are set in main.c (SDA=GPIO11, SCL=GPIO12). There is no
# IDF Kconfig symbol for those pins; do not invent one here.

# Native console on UART0; TinyUSB owns the USB for CDC data.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
